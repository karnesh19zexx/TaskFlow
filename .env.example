# Clerk (https://dashboard.clerk.com -> API Keys). Leave empty in development to use Clerk keyless mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# MongoDB Atlas connection string (or mongodb://localhost:27017/taskflow for local dev)
MONGODB_URI=mongodb://localhost:27017/taskflow

# Realtime service (realtime/server.ts). Leave NEXT_PUBLIC_REALTIME_URL empty to disable live updates.
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000
# Shared secret between the app and the realtime service (tickets + publish auth). Use a long random value.
REALTIME_SECRET=
# Optional: private URL the app uses to publish (defaults to NEXT_PUBLIC_REALTIME_URL).
REALTIME_INTERNAL_URL=
# Realtime service only: comma-separated origins allowed to connect.
REALTIME_CORS_ORIGIN=http://localhost:3000
